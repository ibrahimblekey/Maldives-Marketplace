# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL connection string.
# Local dev (native Postgres or docker-compose, see README):
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/maldives_marketplace?schema=public"

# Auth.js session/JWT signing secret. Generate one with:
#   openssl rand -base64 32
# Must be set to a real random value in every environment (dev, staging,
# production) — never reuse the same secret across environments, and never
# commit a real value to source control.
AUTH_SECRET="replace-with-a-random-32-byte-base64-value"

# Base URL of the app. Used by Auth.js for callback URLs.
NEXTAUTH_URL="http://localhost:3000"

# Optional: overrides for `npm run db:seed`'s dev admin account.
# If unset, the seed script defaults to admin@example.com / ChangeMe123!
# SEED_ADMIN_EMAIL="admin@example.com"
# SEED_ADMIN_PASSWORD="ChangeMe123!"
