# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL connection string.
# Local dev (native Postgres or docker-compose, see README):
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/maldives_marketplace?schema=public"

# Auth.js session/JWT signing secret. Generate one with:
#   openssl rand -base64 32
# Must be set to a real random value in every environment (dev, staging,
# production) — never reuse the same secret across environments, and never
# commit a real value to source control.
AUTH_SECRET="replace-with-a-random-32-byte-base64-value"

# Base URL of the app. Used by Auth.js for callback URLs.
NEXTAUTH_URL="http://localhost:3000"

# Optional: overrides for `npm run db:seed`'s dev admin account.
# If unset, the seed script defaults to admin@example.com / ChangeMe123!
# SEED_ADMIN_EMAIL="admin@example.com"
# SEED_ADMIN_PASSWORD="ChangeMe123!"

# Vercel Blob read/write token for listing photos. On Vercel this is added
# automatically when a Blob store is connected to the project. Leave unset
# locally to store photos in public/dev-uploads/ instead (development only).
# BLOB_READ_WRITE_TOKEN=""

# Shown to hosts on their commission statements: how to pay the platform,
# e.g. "Bank of Maldives, account 7730000000000, name Maldives Marketplace Pvt Ltd.
# Use the statement month as the reference."
# COMMISSION_PAYMENT_INSTRUCTIONS=""

# Email (Resend). Without RESEND_API_KEY emails are only logged, not sent.
# RESEND_API_KEY=""
# Needs a domain verified in Resend; leave unset to use Resend's test sender
# (which only delivers to your own Resend account email).
# EMAIL_FROM="Maldives Marketplace <bookings@your-domain.com>"
# Protects the daily reminder job (/api/cron/daily). Any long random text.
# CRON_SECRET=""
